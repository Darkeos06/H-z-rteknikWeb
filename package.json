  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation node --loader ts-node/esm src/seed/index.ts",
    "seed:blog-posts": "cross-env NODE_OPTIONS=--no-deprecation node --loader ts-node/esm src/seed/data/blog-posts-2026.ts",
    "seed:faq-pages": "cross-env NODE_OPTIONS=--no-deprecation node --loader ts-node/esm src/seed/data/faq-pages.ts",
    "seed:price-guides": "cross-env NODE_OPTIONS=--no-deprecation node --loader ts-node/esm src/seed/data/price-guides.ts",
    "seed:otomasyon": "cross-env NODE_OPTIONS=--no-deprecation node --loader ts-node/esm src/seed/data/otomasyon-category.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
